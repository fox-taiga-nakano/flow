{
    "name": "flow-orchestrator",
    "version": "0.1.2",
    "description": "Project-configurable issue workflow orchestrator",
    "license": "MIT",
    "bin": {
        "flow": "dist/main.mjs"
    },
    "files": [
        "README.md",
        "bin",
        "dist",
        "docs",
        "skills",
        "templates",
        "tools"
    ],
    "type": "module",
    "scripts": {
        "dev": "turbo dev",
        "build": "pnpm build:cli && turbo run build",
        "build:cli": "vp pack",
        "build:test-fixtures": "vp pack --no-config test/fixtures/epipe-cli.mjs src/core/locks.ts --out-dir test/.build && cp test/fixtures/WORKFLOW.md test/.build/test/fixtures/WORKFLOW.md",
        "check": "vp check",
        "format": "vp fmt",
        "format:check": "vp fmt --check",
        "pretest": "pnpm build:cli && pnpm build:test-fixtures",
        "test": "vp test run",
        "typecheck": "tsc --noEmit",
        "lint": "vp lint",
        "docs:dev": "pnpm --filter @flow/docs dev --background",
        "docs:generate": "node --disable-warning=ExperimentalWarning --experimental-transform-types --import ./scripts/docs/source-loader.mjs ./scripts/docs/generate.mjs",
        "docs:check": "node --disable-warning=ExperimentalWarning --experimental-transform-types --import ./scripts/docs/source-loader.mjs ./scripts/docs/generate.mjs --check",
        "docs:build": "pnpm --filter @flow/docs build && node scripts/docs/links.mjs"
    },
    "dependencies": {
        "cli-table3": "0.6.5",
        "commander": "15.0.0",
        "picocolors": "1.1.1",
        "string-width": "8.1.0",
        "yaml": "^2.8.1"
    },
    "devDependencies": {
        "@types/node": "^22.18.0",
        "turbo": "^2.11.11",
        "typescript": "^5.9.2",
        "vite-plus": "^1.4.0"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.15.0"
}
